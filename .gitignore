# Defense in depth only. Import exactly the reviewed manifest from this source root.
# Never import the parent workspace or sibling review/scanner/withheld directories.

# Environment files; reviewed example templates remain visible.
.env
.env.*
!.env.example
!.env.sample
!.env.template

