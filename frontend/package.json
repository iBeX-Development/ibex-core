{
  "private": true,
  "name": "tairo",
  "version": "1.1.2",
  "type": "module",
  "main": "./nuxt.config.ts",
  "engines": {
    "node": ">=16.15",
    "pnpm": ">=7"
  },
  "scripts": {
    "dev": "cross-env PORT=3001 nuxi dev .app --open",
    "start": "cross-env PORT=3001 nuxi start .app --open",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 nuxi build .app",
    "generate": "node .app/scripts/generate_interface.js",
    "clean:all": "pnpm -r clean && rimraf .nuxt .output node_modules",
    "test": "run-p test:*",
    "test:tsc-demo": "vue-tsc --noEmit -p .demo/tsconfig.json",
    "test:lint": "run-s lint:eslint lint:prettier",
    "lint": "run-s lint:eslint:fix lint:eslint:fix-demo lint:prettier:fix",
    "lint:prettier": "prettier --check \"./**/*.(ts|vue|css|md)\"",
    "lint:prettier:fix": "prettier --write \"./**/*.(ts|vue|css|md)\"",
    "lint:eslint": "eslint -c .eslintrc.cjs --ext .vue,.ts .",
    "lint:eslint:fix": "eslint -c .eslintrc.cjs --fix --ext .vue,.ts .",
    "lint:eslint:fix-demo": "eslint -c layers/documentation/examples/.eslintrc.cjs --fix --ext .vue layers/documentation/examples"
  },
  "devDependencies": {
    "@iconify/json": "2.2.67",
    "@parcel/watcher": "2.1.0",
    "@types/fs-extra": "11.0.1",
    "@typescript-eslint/eslint-plugin": "5.59.6",
    "cross-env": "^7.0.3",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-prettier-vue": "4.2.0",
    "eslint-plugin-tailwindcss": "3.12.0",
    "eslint-plugin-vue": "9.13.0",
    "eslint-plugin-vuejs-accessibility": "2.1.0",
    "esno": "0.16.3",
    "fs-extra": "11.1.1",
    "glob": "^10.3.0",
    "lint-staged": "13.2.2",
    "npm-run-all": "4.1.5",
    "prettier": "2.8.8",
    "rimraf": "^5.0.0",
    "std-env": "3.3.3",
    "typescript": "5.0.4",
    "vue-tsc": "1.6.5",
    "vuetify-nuxt-module": "^0.12.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.(ts|vue)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "postcss",
        "vue",
        "vite",
        "@unhead/vue",
        "webpack"
      ]
    },
    "overrides": {
      "consola": "3.2.3",
      "listhen": "1.7.2"
    }
  },
  "dependencies": {
    "@daypilot/daypilot-lite-vue": "^4.0.2",
    "@directus/sdk": "^17.0.1",
    "@formkit/nuxt": "^1.6.7",
    "@fullcalendar/core": "^6.1.17",
    "@fullcalendar/daygrid": "^6.1.17",
    "@fullcalendar/interaction": "^6.1.17",
    "@fullcalendar/resource-timeline": "^6.1.17",
    "@fullcalendar/timegrid": "^6.1.17",
    "@fullcalendar/timeline": "^6.1.17",
    "@fullcalendar/vue3": "^6.1.17",
    "@mdi/font": "^7.3.67",
    "@mdi/js": "^7.3.67",
    "@nuxt/devtools": "^1.5.1",
    "@vue/typescript": "^1.8.8",
    "ag-grid-community": "^32.1.0",
    "ag-grid-enterprise": "^32.1.0",
    "ag-grid-vue3": "^32.1.0",
    "axios": "^1.7.7",
    "docx-preview": "^0.3.5",
    "firebase": "^11.9.1",
    "html2pdf.js": "^0.10.3",
    "mammoth": "^1.11.0",
    "nuxt-directus": "^5.6.1",
    "pdfjs-dist": "^5.3.31",
    "pinia": "^2.1.6",
    "qalendar": "^3.9.0",
    "sass": "^1.80.7",
    "sass-loader": "^16.0.3",
    "vs-vue3-select": "^1.3.5",
    "vue-draggable-next": "^2.2.1",
    "vue-i18n": "^10.0.3",
    "vuedraggable": "^4.1.0",
    "xlsx": "^0.18.5"
  }
}
